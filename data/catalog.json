        },
        {
          "key": "engineering",
          "name": "Engineering",
          "from": "engineering",
          "desc": "Full submittal engineering · due after contract signing"
        },
        {
          "key": "materials",
          "name": "Materials (45%)",
          "pct": 45,
          "desc": "45% of contract · due after engineering"
        },
        {
          "key": "preship",
          "name": "Pre-ship (45%)",
          "pct": 45,
          "desc": "45% of contract · due when kit ready to ship"
        },
        {
          "key": "final",
          "name": "Final set (10%)",
          "pct": 10,
          "desc": "10% of contract · due when set on site",
          "absorbs_rounding": true
        }
      ]
    },
    "custom_home_default": {
      "label": "Custom Home editable schedule (starting point)",
      "stages": [
        {
          "name": "Materials",
          "pct": 45,
          "desc": "45% of contract · due after engineering"
        },
        {
          "name": "Pre-ship",
          "pct": 45,
          "desc": "45% of contract · due before shipment"
        },
        {
          "name": "Final set",
          "pct": 10,
          "desc": "10% of contract · due on set"
        }
      ]
    },
    "zk_modular": {
      "label": "5 / 30 / 30 / 30 / 5 (same wording as the modular contract)",
      "stages": [
        {
          "key": "pay1",
          "name": "Payment 1 — Design & Engineering (5%)",
          "pct": 5,
          "desc": "At project start — drafting, coordination, and project setup."
        },
        {
          "key": "pay2",
          "name": "Payment 2 — Materials & Production (30%)",
          "pct": 30,
          "desc": "Once plans are approved — secures materials and the factory production slot."
        },
        {
          "key": "pay3",
          "name": "Payment 3 — Construction Begins (30%)",
          "pct": 30,
          "desc": "Factory fabrication commences."
        },
        {
          "key": "pay4",
          "name": "Payment 4 — Factory Completion (30%)",
          "pct": 30,
          "desc": "Unit complete and ready for transport."
        },
        {
          "key": "final",
          "name": "Payment 5 — Set & Completion (5%)",
          "pct": 5,
          "desc": "After delivery and set on the foundation.",
          "absorbs_rounding": true
        }
      ]
    }
